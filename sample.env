# ═══════════════════════════════════════════════════════════════════════════
# ArbiScanner Environment Variables
# ═══════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# External URLs & Host Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Replace with your GCP external IP or domain when deploying
# Example: GCP_HOST=http://12.123.12.12
GCP_HOST=

# CORS allowed origins for backend APIs
WEB_CLIENT_URL=
ADMIN_CLIENT_URL=

# API base URLs injected into the React clients at build time (VITE_API_URL)
# WEB_API_URL is empty — web client uses relative /api/ path through nginx
WEB_API_URL=
# The admin panel SPA is reverse-proxied under /admin and its API under /adminapi
# on the same domain as the web client (see ArbiScannerWebApp/nginx.conf), so set
# this to /adminapi — the client then calls /adminapi/api/... which the gateway
# strips down to admin-api's own /api/... routes.
ADMIN_API_URL=/adminapi

# ─────────────────────────────────────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
ADMIN_POSTGRES_DB=
POSTGRES_HOST=
POSTGRES_PORT=

# MongoDB Configuration
MONGODB_HOST=
MONGODB_PORT=
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_DATABASE_NAME=
MONGODB_CURRENT_SPREADS_COLLECTION=
MONGODB_SPREADS_TICKER_COLLECTION=
MONGO_DB_CONNECTION_STRING=

# ─────────────────────────────────────────────────────────────────────────────
# RabbitMQ Configuration
# ─────────────────────────────────────────────────────────────────────────────
RABBITMQ_HOST=
RABBITMQ_PORT=
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
RABBITMQ_EXCHANGE=
RABBITMQ_QUEUE_SPREAD_API=
RABBITMQ_QUEUE_SPREAD_TELEGRAM=
RABBITMQ_ROUTING_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Redis Configuration
# ─────────────────────────────────────────────────────────────────────────────
REDIS_ENDPOINT=
REDIS_HOST=
REDIS_PORT=

# ─────────────────────────────────────────────────────────────────────────────
# Telegram Bot Configuration
# ─────────────────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ─────────────────────────────────────────────────────────────────────────────
# Email Configuration
# ─────────────────────────────────────────────────────────────────────────────
SMTP_SERVER=
SMTP_PORT=
SENDER_EMAIL=
SENDER_PASSWORD=
SENDER_NAME=

# ─────────────────────────────────────────────────────────────────────────────
# Keycloak / OIDC Configuration - ArbiScannerWebApp
# ArbiScannerWebApp's auth moved from a self-issued JWT to Keycloak (see
# docs/investigations/oauth-oidc-migration.md and keycloak/README.md).
# ArbiScannerAdminPannel's own OIDC config follows further below.
# ─────────────────────────────────────────────────────────────────────────────
# Keycloak's own admin console credentials (bootstrap admin, realm master) —
# shared across both realms, one Keycloak instance.
KEYCLOAK_ADMIN_USER=
KEYCLOAK_ADMIN_PASSWORD=

# Resource-server config consumed by ArbiScannerWeb.API's AddJwtBearer
# (Jwt__Authority / Jwt__Audience) — JWKS is auto-discovered from Authority.
OIDC_AUTHORITY_WEBAPP=https://auth.arbiscannerwebapp.site/realms/arbiscanner-web
OIDC_AUDIENCE_WEBAPP=arbiscanner-web-spa

# Build-time config injected into the React client (VITE_OIDC_*), same pattern
# as VITE_API_URL above.
VITE_OIDC_AUTHORITY=https://auth.arbiscannerwebapp.site/realms/arbiscanner-web
VITE_OIDC_CLIENT_ID=arbiscanner-web-spa
VITE_OIDC_REDIRECT_URI=https://www.arbiscannerwebapp.site/auth/callback

# ─────────────────────────────────────────────────────────────────────────────
# Keycloak / OIDC Configuration - ArbiScannerAdminPannel
# ArbiScannerAdminPannel's auth also moved to Keycloak, realm arbiscanner-admin
# (separate realm, same Keycloak instance — see keycloak/README.md). Unlike
# arbiscanner-web, this realm has registrationAllowed=false (staff-only) and
# carries Administrator/Manager realm roles.
# ─────────────────────────────────────────────────────────────────────────────
# Resource-server config consumed by ArbiScannerAdminPanel.API's AddJwtBearer.
OIDC_AUTHORITY_ADMINPANEL=https://auth.arbiscannerwebapp.site/realms/arbiscanner-admin
OIDC_AUDIENCE_ADMINPANEL=arbiscanner-admin-api

# Build-time config injected into the admin React client.
VITE_OIDC_AUTHORITY_ADMINPANEL=https://auth.arbiscannerwebapp.site/realms/arbiscanner-admin
VITE_OIDC_CLIENT_ID_ADMINPANEL=arbiscanner-admin-spa
VITE_OIDC_REDIRECT_URI_ADMINPANEL=https://www.arbiscannerwebapp.site/admin/auth/callback

# Client Credentials secret for the arbiscanner-admin-service confidential
# client — used by ArbiScannerWeb.Infrastructure's AdminService for
# server-to-server calls into ArbiScannerAdminPannel's API (see
# keycloak/README.md step 7 for how to obtain the secret).
KEYCLOAK_ADMIN_SERVICE_CLIENT_ID=arbiscanner-admin-service
KEYCLOAK_ADMIN_SERVICE_CLIENT_SECRET=

# Client Credentials secret for the arbiscanner-web-admin-ops confidential
# client (arbiscanner-web realm, not arbiscanner-admin) — used by
# ArbiScannerAdminPannel's UsersService to delete the Keycloak identity when
# an admin deletes a user, so their email is actually freed up instead of
# only clearing the local shadow row. Needs the realm-management/manage-users
# client role on its service account (see keycloak/README.md).
KEYCLOAK_WEB_ADMIN_OPS_CLIENT_ID=arbiscanner-web-admin-ops
KEYCLOAK_WEB_ADMIN_OPS_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────────────
# Admin User Configuration
# ADMIN_USERNAME/PASSWORD and MANAGER_USERNAME/PASSWORD provision the initial
# Keycloak staff accounts in the arbiscanner-admin realm (see
# keycloak/configure-admin-users.sh) — no longer used for app-level seeding.
# ─────────────────────────────────────────────────────────────────────────────
ADMIN_USERNAME=
ADMIN_PASSWORD=
MANAGER_USERNAME=
MANAGER_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# Monitoring & Logging Configuration
# ─────────────────────────────────────────────────────────────────────────────
LOKI_HOST=
LOKI_PORT=
LOKI_URI=

GRAFANA_HOST=
GRAFANA_PORT=
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=

# Prometheus has no login of its own — the gateway nginx (web-client) gates its
# /prometheus/ route with HTTP basic auth built from these at container startup.
PROMETHEUS_BASIC_AUTH_USER=
PROMETHEUS_BASIC_AUTH_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
# OxaPay Configuration
# ─────────────────────────────────────────────────────────────────────────────
OXAPAY_BASE_URL=
OXAPAY_MERCHANT_API_KEY=
OXAPAY_DEFAULT_CURRENCY=
OXAPAY_DEFAULT_LIFETIME=
OXAPAY_SANDBOX=

# ─────────────────────────────────────────────────────────────────────────────
# E2E Load Test Configuration - ArbiScannerWebApp (ArbiScannerWeb.LoadTests)
# Consumed directly by the test process (not by docker-compose), so run
# `dotnet test` with these exported, or set them in your shell/CI env.
# Tests skip automatically when BASE_URL/EMAIL/PASSWORD/OIDC_* are left blank.
# Login goes through Keycloak's Resource Owner Password Credentials grant
# against the dedicated arbiscanner-web-loadtest client (direct-grant enabled,
# unlike the browser SPA client — see keycloak/realm-export). EMAIL/PASSWORD
# must be a real Keycloak user's credentials in the arbiscanner-web realm.
# ─────────────────────────────────────────────────────────────────────────────
WEB_LOADTEST_BASE_URL=
WEB_LOADTEST_EMAIL=
WEB_LOADTEST_PASSWORD=
WEB_LOADTEST_OIDC_AUTHORITY=https://auth.arbiscannerwebapp.site/realms/arbiscanner-web
WEB_LOADTEST_OIDC_CLIENT_ID=arbiscanner-web-loadtest
WEB_LOADTEST_QUERIES_PER_MINUTE=
WEB_LOADTEST_DURATION_SECONDS=

# ─────────────────────────────────────────────────────────────────────────────
# E2E Load Test Configuration - ArbiScannerAdminPannel (ArbiScannerAdminPanel.LoadTests)
# Consumed directly by the test process (not by docker-compose), so run
# `dotnet test` with these exported, or set them in your shell/CI env.
# Tests skip automatically when BASE_URL/USERNAME/PASSWORD/OIDC_* are left blank.
# Login goes through Keycloak's Resource Owner Password Credentials grant
# against the dedicated arbiscanner-admin-loadtest client (direct-grant
# enabled, unlike the browser SPA client — see keycloak/realm-export).
# USERNAME/PASSWORD must be a real Keycloak staff user's credentials in the
# arbiscanner-admin realm (Administrator role required for the
# SubscriptionUpdateLoadTest specifically).
# ─────────────────────────────────────────────────────────────────────────────
ADMINPANEL_LOADTEST_BASE_URL=
ADMINPANEL_LOADTEST_USERNAME=
ADMINPANEL_LOADTEST_PASSWORD=
ADMINPANEL_LOADTEST_OIDC_AUTHORITY=https://auth.arbiscannerwebapp.site/realms/arbiscanner-admin
ADMINPANEL_LOADTEST_OIDC_CLIENT_ID=arbiscanner-admin-loadtest
ADMINPANEL_LOADTEST_QUERIES_PER_MINUTE=
ADMINPANEL_LOADTEST_DURATION_SECONDS=

# ─────────────────────────────────────────────────────────────────────────────
# Application Configuration
# ─────────────────────────────────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=

# ─────────────────────────────────────────────────────────────────────────────
# ArbitrageScanner Configuration
# ─────────────────────────────────────────────────────────────────────────────
ARBITRAGE_SPREAD_SIZE=
ARBITRAGE_POSITION_SIZE=
ARBITRAGE_KEEP_WATCHING_SPREAD=
ARBITRAGE_THREAD_COUNT=
ARBITRAGE_FUNDING_THRESHOLD_RATIO=
ARBITRAGE_CHAT_ID=
ARBITRAGE_FUTURES=
ARBITRAGE_FUNDING=
ARBITRAGE_SPOT=

# Comma-separated exchange names (ccxt ids), e.g. Binance,Bybit,MEXC,OKX. Moves
# what used to live only in ArbitrageScanner.Worker/appsettings.json into .env
# so exchanges/proxies can be changed without a rebuild.
ARBITRAGE_EXCHANGE_LIST=
# JSON array of proxy entries: [{"ip":"...","port":1234,"country_code":"..","username":"..","password":".."}, ...]
ARBITRAGE_PROXY_LIST=

# ─────────────────────────────────────────────────────────────────────────────
# OpenTelemetry Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Master switch for tracing + Prometheus metrics across all 4 .NET services.
# Set to false to skip OTel/Prometheus registration entirely (e.g. low-resource VPS).
OBSERVABILITY_ENABLED=true
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=

# When true, raises the console (and Loki) minimum log level to Debug across all
# 4 .NET services - useful when it's easier to check a container's console output
# than to go look in Grafana.
VERBOSE_CONSOLE_LOGS=false
